  "gradient": {
    "brand": {
      "$type": "gradient",
      "$value": [
        {
          "color": "#4F46E5",
          "position": 0
        },
        {
          "color": "#8B5CF6",
          "position": 1
        }
      ],
      "$extensions": {
        "dev.buijs.stratastax": {
          "angle": 135,
          "modes": {
            "dark": [
              {
                "color": "#818CF8",
                "position": 0
              },
              {
                "color": "#A78BFA",
                "position": 1
              }
            ]
          }
        }
      }
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "md": {
