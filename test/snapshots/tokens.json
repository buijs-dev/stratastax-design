      ]
    }
  },
  "typography": {
    "header1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Plus Jakarta Sans",
        "fontWeight": 800,
        "fontSize": {
          "value": 30,
          "unit": "px"
        },
        "lineHeight": 1.15,
